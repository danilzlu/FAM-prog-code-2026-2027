{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build C (macOS / Clang)",
      "type": "process",
      "command": "/usr/bin/clang",
      "args": ["-std=c17", "-Wall", "-Wextra", "-g", "-O0", "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}"],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build C (Linux / GCC)",
      "type": "process",
      "command": "/usr/bin/gcc",
      "args": ["-std=c17", "-Wall", "-Wextra", "-g", "-O0", "${file}", "-o", "${fileDirname}/${fileBasenameNoExtension}"],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build C (Windows / WinLibs GCC)",
      "type": "process",
      "command": "C:\\winlibs\\mingw64\\bin\\gcc.exe",
      "args": ["-std=c17", "-Wall", "-Wextra", "-g", "-O0", "${file}", "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe"],
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"]
    }
  ]
}
